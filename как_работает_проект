## Wiring in main.go

```go
// cmd/catalog/main.go (excerpt)

import (
    "myproject/internal/catalog/domain/repositories"
    "myproject/internal/catalog/infrastructure/persistence"
    "myproject/internal/catalog/application/queries"
    "myproject/internal/catalog/api/handlers"
    "github.com/gin-gonic/gin"
    "github.com/jmoiron/sqlx"
    _ "github.com/lib/pq"
)

func main() {
    // ... existing setup ...
    db, _ := sqlx.Connect("postgres", "postgres://user:pass@localhost:5432/dbname?sslmode=disable")
    // Repository implementations
    itemRepo := persistence.NewItemRepository(db)
    // Business layer
    itemsHandler := &queries.ItemsHandler{Repo: itemRepo}
    // HTTP layer
    itemsHTTP := handlers.NewItemsHTTPHandler(itemsHandler)

    r := gin.Default()
    v1 := r.Group("/api/v1")
    // existing routes
    v1.GET("/items", itemsHTTP.List)
    // start server
    r.Run()
}
```


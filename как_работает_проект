## Репозиторий Item

### Сущность `Item`
```go
type Item struct {
    ID          int64    // Уникальный идентификатор
    BrandID     int64    // Связь с брендом
    CategoryID  int64    // Связь с категорией
    Name        string   // Наименование товара
    Description string   // Описание товара
    Price       float64  // Цена
    CreatedAt   time.Time
    UpdatedAt   time.Time
}
```

### Интерфейс репозитория
```go
package repositories

import "context"

type ItemRepository interface {
    // Получить все товары
    Items(ctx context.Context) ([]entities.Item, error)
    // Получить товар по ID
    GetByID(ctx context.Context, id int64) (entities.Item, error)
    // Создать новый товар
    Create(ctx context.Context, item entities.Item) (int64, error)
    // Обновить существующий товар
    Update(ctx context.Context, item entities.Item) error
    // Удалить товар
    Delete(ctx context.Context, id int64) error
}
```

### Реализация в `infrastructure/persistence`
```go
package persistence

import (
    "context"
    "database/sql"
    "github.com/jmoiron/sqlx"
    "myproject/internal/catalog/domain/entities"
    "myproject/internal/catalog/domain/repositories"
)

type itemRepo struct {
    db *sqlx.DB
}

func NewItemRepository(db *sqlx.DB) repositories.ItemRepository {
    return &itemRepo{db: db}
}

func (r *itemRepo) Items(ctx context.Context) ([]entities.Item, error) {
    var items []entities.Item
    err := r.db.SelectContext(ctx, &items, "SELECT id, brand_id, category_id, name, description, price, created_at, updated_at FROM items")
    return items, err
}

func (r *itemRepo) GetByID(ctx context.Context, id int64) (entities.Item, error) {
    var item entities.Item
    err := r.db.GetContext(ctx, &item, "SELECT id, brand_id, category_id, name, description, price, created_at, updated_at FROM items WHERE id=$1", id)
    return item, err
}

func (r *itemRepo) Create(ctx context.Context, item entities.Item) (int64, error) {
    var id int64
    err := r.db.QueryRowxContext(ctx, "INSERT INTO items (brand_id, category_id, name, description, price, created_at, updated_at) VALUES ($1,$2,$3,$4,$5,now(),now()) RETURNING id",
        item.BrandID, item.CategoryID, item.Name, item.Description, item.Price).Scan(&id)
    return id, err
}

func (r *itemRepo) Update(ctx context.Context, item entities.Item) error {
    _, err := r.db.ExecContext(ctx, "UPDATE items SET brand_id=$1, category_id=$2, name=$3, description=$4, price=$5, updated_at=now() WHERE id=$6",
        item.BrandID, item.CategoryID, item.Name, item.Description, item.Price, item.ID)
    return err
}

func (r *itemRepo) Delete(ctx context.Context, id int64) error {
    _, err := r.db.ExecContext(ctx, "DELETE FROM items WHERE id=$1", id)
    return err
}
```

### Использование в бизнес‑слое
```go
type ItemsHandler struct {
    repo repositories.ItemRepository
}

func (h *ItemsHandler) List(ctx context.Context) ([]entities.Item, error) {
    return h.repo.Items(ctx)
}
```

> **Важно:** бизнес‑слой зависит лишь от интерфейса `ItemRepository`, поэтому для тестов можно подменить его мок‑реализацией, а в проде подключить `persistence`‑реализацию, работающую с PostgreSQL.


## API Handlers for Items

```go
package handlers

import (
    "context"
    "myproject/internal/catalog/application/queries"
    "myproject/internal/catalog/domain/entities"
    "net/http"
    "github.com/gin-gonic/gin"
)

type ItemsHTTPHandler struct {
    query *queries.ItemsHandler
}

func NewItemsHTTPHandler(q *queries.ItemsHandler) *ItemsHTTPHandler {
    return &ItemsHTTPHandler{query: q}
}

func (h *ItemsHTTPHandler) List(c *gin.Context) {
    items, err := h.query.List(c.Request.Context())
    if err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
        return
    }
    c.JSON(http.StatusOK, gin.H{"data": items})
}
```

